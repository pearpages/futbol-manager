{
  "name": "futbol-manager",
  "version": "0.0.0",
  "description": "A football management game for the browser, in the style of Dinamic's PC Fútbol 5.0.",
  "keywords": [
    "football",
    "soccer",
    "manager",
    "game",
    "pc-futbol",
    "browser-game",
    "react"
  ],
  "homepage": "https://futbol.pearpages.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearpages/futbol-manager.git"
  },
  "bugs": {
    "url": "https://github.com/pearpages/futbol-manager/issues"
  },
  "author": "pearpages",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fm/app dev",
    "dev:lan": "pnpm --filter @fm/app dev --host",
    "storybook": "pnpm --filter @fm/app storybook",
    "build": "pnpm -r build",
    "test": "vitest",
    "season": "node scripts/season.ts",
    "fixture": "node scripts/fixture.ts",
    "look": "node scripts/look.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel exec tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:update": "playwright test --project visual --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
